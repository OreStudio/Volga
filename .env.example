# Volga configuration. Copy to .env and fill in the values.
#
# `.env` is gitignored because it names certificate private keys.

# Where the browser-facing HTTP server listens.
VOLGA_BFF_PORT=8080
VOLGA_BFF_HOST=127.0.0.1

# The bus. Each service presents its own client certificate, and the BFF is an
# interactive client, so it uses the Qt client certificate.
VOLGA_NATS_URL=nats://localhost:21805
VOLGA_NATS_SUBJECT_PREFIX=ores.dev.festive.dijkstra
VOLGA_NATS_WIRE_FORMAT=msgpack
VOLGA_NATS_TLS_CA=/path/to/build/keys/nats/ca.crt
VOLGA_NATS_TLS_CERT=/path/to/build/keys/nats/ores.qt.client.crt
VOLGA_NATS_TLS_KEY=/path/to/build/keys/nats/ores.qt.client.key

# Secret for the session cookie. At least 32 characters. A default would be a
# backdoor, so the process refuses to start without one.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VOLGA_SESSION_SECRET=
VOLGA_SESSION_TTL_SECONDS=28800

# Set to true wherever the server is reached over HTTPS.
VOLGA_COOKIE_SECURE=false

# Origins allowed to call the API.
VOLGA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
